{
  "name": "sct-aussendienst",
  "private": true,
  "license": "UNLICENSED",
  "version": "1.0.0",
  "type": "module",
  "description": "Aussendienst-App der SC-Technologie AG: potenzielle Kunden aus dem Handelsregister auf der Schweizer Karte, Wochenplanung mit Routenvorschlag und Google-Maps-Übergabe.",
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-daten.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "register:monat": "node scripts/handelsregister.mjs --modus=monat",
    "register:bestand": "node scripts/handelsregister.mjs --modus=bestand",
    "demo-daten": "node scripts/demo-daten.mjs"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "leaflet": "^1.9.4"
  }
}
